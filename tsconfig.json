{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "./prisma/*.ts",
    "**/*.tsx",
    "**/*.tsx",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    "src/app/api/auth/[..nextauth]/route.js",
    "Pending/services/report/template.generate.tss",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
